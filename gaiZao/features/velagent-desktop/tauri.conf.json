{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VelAgent",
  "version": "0.1.0",
  "identifier": "ai.enrui.velagent",
  "build": {
    "frontendDist": "../velagent-ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../velagent-ui run dev",
    "beforeBuildCommand": "npm --prefix ../velagent-ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VelAgent",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}